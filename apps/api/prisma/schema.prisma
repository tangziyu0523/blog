generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  nickname        String
  bio             String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  githubId        String?   @unique
  githubLogin     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([githubId])
}
