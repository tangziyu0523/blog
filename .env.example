# 复制为 .env 并填入真实值；.env 已被 gitignore，密钥绝不入库
DATABASE_URL=postgresql://blog:blog@localhost:5432/blog
REDIS_URL=redis://localhost:6379

# 对象存储（开发用 MinIO）
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=blog
# 前端用：把头像 key 拼成可访问 URL（= S3_ENDPOINT/S3_BUCKET）
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/blog

# 认证
NODE_ENV=development
PORT=3001
# Number of reverse-proxy hops to trust for the client IP (0 = none, use socket IP).
# Set to 1 if a single reverse proxy (nginx/caddy/LB) terminates connections in prod.
TRUST_PROXY=0
JWT_ACCESS_SECRET=change-me-to-a-32-char-min-random-string
JWT_REFRESH_SECRET=change-me-to-another-32-char-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback
WEB_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# LLM 网关
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────────────────────
# 生产环境形态（实际值配置在 Render / Vercel 控制台，不入库）
# 不绑卡栈：Vercel(web) + Render(api) + Supabase(PG/存储) + Upstash(Redis)
# 详见 docs/superpowers/specs/2026-06-16-m8-deployment-design.md（修订二）
# ──────────────────────────────────────────────────────────────
# 无自有域名：web 用 *.vercel.app、api 用 *.onrender.com（跨站）。
# 跨站要求 Cookie 走 SameSite=None+Secure —— 由 NODE_ENV=production 自动触发，
# 且不设 COOKIE_DOMAIN（host-only Cookie）。注意：Safari 默认拦第三方 Cookie。
# Render(api):
#   DATABASE_URL=<Supabase Session pooler 连接串>
#   REDIS_URL=<Upstash rediss:// 连接串>
#   NODE_ENV=production                  # 触发 secure + SameSite=None
#   TRUST_PROXY=1
#   WEB_ORIGIN=https://<web>.vercel.app
#   # 不要设 COOKIE_DOMAIN（留空 = host-only，跨站必须）
#   # PORT 由 Render 注入，不要手动设
#   GITHUB_CALLBACK_URL=https://<api>.onrender.com/auth/github/callback
#   S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
#   S3_REGION=<Supabase 项目区域，如 ap-south-1>
#   S3_ACCESS_KEY / S3_SECRET_KEY = Supabase Storage S3 access key
#   S3_BUCKET=blog-prod
# Vercel(web) 构建期：
#   NEXT_PUBLIC_API_URL=https://<api>.onrender.com
#   NEXT_PUBLIC_S3_PUBLIC_URL=https://<ref>.supabase.co/storage/v1/object/public/blog-prod
